{
  "name": "spotify-stats",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "zod": "^4.6.7",
      "typescript": "^6.0.3",
      "varlock": "1.25.0",
      "lucide-react": "^1.72.0",
      "next-themes": "^0.4.6",
      "react": "^19.3.1",
      "react-dom": "^19.3.1",
      "sonner": "^2.0.8",
      "tailwindcss": "^4.3.5",
      "@orpc/server": "^1.16.2",
      "@orpc/client": "^1.16.2",
      "@orpc/openapi": "^1.16.2",
      "@orpc/zod": "^1.16.2",
      "@types/react": "^19.3.0",
      "@types/react-dom": "^19.3.0"
    }
  },
  "type": "module",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "check-types": "turbo run check-types",
    "dev:web": "turbo run dev -F web --",
    "env:generate": "varlock codegen --path ./apps/web/",
    "postinstall": "varlock codegen --path ./apps/web/",
    "test": "turbo run test"
  },
  "dependencies": {
    "zod": "catalog:"
  },
  "devDependencies": {
    "@spotify-stats/config": "workspace:*",
    "@types/node": "^26.6.6",
    "turbo": "^2.11.11",
    "typescript": "catalog:",
    "varlock": "catalog:"
  },
  "packageManager": "bun@1.3.13"
}
