# @defaultRequired=true
# @defaultSensitive=true
# @currentEnv=$NODE_ENV
# @generateTsTypes(path=./src/env.ts, exposeEnv=local, auto=not(forEnv(production)))
# ---
# Deployment values are @dynamic: they are resolved when the server boots, never
# frozen into the build. `bun run build` skips them (see _VARLOCK_FILTER).

# @public @type=enum(development, production, test)
NODE_ENV=development

# Canonical public URL of this installation (no trailing slash). The redirect URI
# registered in your Spotify app must be exactly APP_URL + /auth/callback.
# Spotify requires HTTPS, except for loopback addresses such as http://127.0.0.1.
# @public @dynamic @type=url(noTrailingSlash=true) @required=forEnv(production)
APP_URL=

# Client ID of YOUR Spotify app (https://developer.spotify.com/dashboard)
# @public @dynamic @required=forEnv(production)
SPOTIFY_CLIENT_ID=

# Look up tempo, key and audio traits for track pages on ReccoBeats and Deezer.
# Set to false to keep this server from contacting any service other than Spotify.
# @dynamic @sensitive=false @required=false @type=boolean
SOUND_LOOKUPS=true
